# Copy to .env (never commit .env). Leave a key empty to run in template mode (no LLM).
LLM_PROVIDER=groq                      # groq | anthropic | openai | google_genai
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# Optional fallback used automatically on rate-limit / provider errors
LLM_FALLBACK_PROVIDER=anthropic        # used on rate limit / outage of the primary
LLM_FALLBACK_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# Optional: protect /ai/* with an X-API-Key header (unset = no check, for local dev)
AI_API_KEY=
# Embeddings: local_folder | huggingface | fastembed | none (default: local_folder if ./models/all-MiniLM-L6-v2 exists, else none)
EMBEDDINGS_BACKEND=
LLM_FALLBACKS=groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b,anthropic:claude-haiku-5-5   # ordered chain provider:model; each needs its key
