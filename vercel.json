{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend-app && npm ci --legacy-peer-deps --no-audit --no-fund && npm run build",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{data/raw/**,frontend-app/node_modules/**,frontend-app/src/**,frontend-app/samples/**,docs/**,tests/**,notebooks/**,schemas/**,scripts/**,**/*.parquet}"
    }
  }
}
